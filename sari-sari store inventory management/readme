This project is my 1st project and I'll be documenting here what problems did I encounter and what did I do to solve them.

#1 problem: How to add a unique ID to every product created.

solution:

first I experimented using a exp.js file, I traeted the newly created product as an array, as accessing through a class name would make it act like one, then by doing so I was able to tell if there are already created product and to add a new Id for it although it is just a simple Id nonetheleast. Here's the code for my exp.js:

let array = ['item-1'];

console.log(array);

function Id(array, name) {
  let id = 1;
  let result;
  if (array == 0) {
   result = name + '-' + id;
  } else {
   result = name + '-' + (array.length + id);
  }

  return array.push(result);
};
Id(array, 'item');
console.log(array);

and here is the code of the final function:

function ProductId(product) {
  const productLength = document.getElementsByClassName('product');
  let id = 1;

  if (productLength == 0) {
    return product.id = 'product-' + id;
  } else {
    return product.id = 'product-' + (productLength.length + id);
  }
}